// DotaMate schema — Dota 2 teammate-finder. MySQL via Prisma, matching the
// ShakhesOnline reference project's conventions (shared prisma singleton,
// ApiResponse<T> API shape).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rank {
  UNRANKED
  HERALD
  GUARDIAN
  CRUSADER
  ARCHON
  LEGEND
  ANCIENT
  DIVINE
  IMMORTAL
}

enum Position {
  POS1
  POS2
  POS3
  POS4
  POS5
}

enum Region {
  EU_WEST
  EU_EAST
  RUSSIA
  DUBAI
}

enum GameMode {
  RANKED_ALL_PICK
  ALL_PICK
  TURBO
  CAPTAINS_MODE
}

enum SessionType {
  NOW
  SCHEDULED
}

enum PostStatus {
  ACTIVE
  FULL
  EXPIRED
  COMPLETED
  CANCELLED
}

enum MemberStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum RankVerification {
  SELF_DECLARED
  VERIFIED
}

enum NotificationType {
  POST_REQUEST
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  NEW_MESSAGE
  SESSION_REMINDER
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportAction {
  NONE
  WARNED
  SUSPENDED
  BANNED
  POST_REMOVED
  DISMISSED
}

enum AdminResource {
  USERS
  POSTS
  REPORTS
  SESSIONS
  REFERENCE_DATA
  ANNOUNCEMENTS
  AUDIT_LOG
  BLOG
  ROLES
  TICKETS
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ACCOUNT
  TECHNICAL
  GENERAL
  BUG_REPORT
  SUGGESTION
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum AuditAction {
  BAN_USER
  UNBAN_USER
  SUSPEND_USER
  UNSUSPEND_USER
  WARN_USER
  VERIFY_USER
  UNVERIFY_USER
  DELETE_POST
  RESOLVE_REPORT
  DISMISS_REPORT
  CREATE_ROLE
  UPDATE_ROLE
  DELETE_ROLE
  ASSIGN_ROLE
  CREATE_ANNOUNCEMENT
  UPDATE_ANNOUNCEMENT
  DELETE_ANNOUNCEMENT
  PUBLISH_BLOG_POST
  UPDATE_BLOG_POST
  DELETE_BLOG_POST
  UPDATE_REFERENCE_DATA
  CLOSE_TICKET
  REPLY_TICKET
  OVERRIDE_MATCH_GATE
}

model User {
  id               Int               @id @default(autoincrement())
  displayName      String
  email            String?           @unique
  phone            String?           @unique
  passwordHash     String
  bio              String?           @db.Text
  country          String?
  languages        String?
  rank             Rank              @default(UNRANKED)
  rankTier         Int?
  mainPosition     Position?
  rankVerification RankVerification  @default(SELF_DECLARED)
  steamProfileUrl  String?
  steamId          String?           @unique
  avatarUrl        String?
  matchDataVerified Boolean          @default(false)
  matchGateOverride Boolean          @default(false)
  profileCompletedAt DateTime?
  matchStats       DotaMatchStats?
  notifyBell       Boolean           @default(true)
  notifyEmail      Boolean           @default(true)
  notifyPush       Boolean           @default(false)
  sessionReminderEnabled Boolean     @default(true)
  sessionReminderMinutes Int         @default(15)

  roleId           Int?
  role             Role?             @relation(fields: [roleId], references: [id])
  banned           Boolean           @default(false)
  bannedAt         DateTime?
  banReason        String?           @db.Text
  suspendedUntil   DateTime?
  lastActiveAt     DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  posts            Post[]
  memberships      PostMember[]
  favoritesMade    Favorite[]        @relation("FavoritedBy")
  favoritedByUsers Favorite[]        @relation("FavoriteTarget")
  messagesSent     Message[]
  conversations    ConversationParticipant[]
  notifications    Notification[]
  reportsMade      Report[]          @relation("Reporter")
  reportsAgainst   Report[]          @relation("ReportedUser")
  reportsResolved  Report[]          @relation("ReportResolver")
  blocking         Block[]           @relation("Blocker")
  blockedBy        Block[]           @relation("Blocked")
  auditLogs        AuditLog[]        @relation("AuditActor")
  announcements    Announcement[]
  blogPosts        BlogPost[]
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
}

model Post {
  id          Int          @id @default(autoincrement())
  authorId    Int
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  position    Position
  rank        Rank
  gameMode    GameMode
  region      Region
  sessionType SessionType
  startAt     DateTime?
  partySize   Int          @default(5)
  description String       @db.Text
  hasVoice    Boolean      @default(true)
  voiceLink   String?
  status      PostStatus   @default(ACTIVE)
  bumpedAt    DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     PostMember[]
  messages    Message[]
  reports     Report[]

  @@index([status, sessionType])
  @@index([authorId])
}

model PostMember {
  id        Int          @id @default(autoincrement())
  postId    Int
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    MemberStatus @default(PENDING)
  position  Position?
  createdAt DateTime     @default(now())

  @@unique([postId, userId])
}

model Favorite {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation("FavoritedBy", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUserId Int
  favoriteUser   User     @relation("FavoriteTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)
  note           String?
  createdAt      DateTime @default(now())

  @@unique([userId, favoriteUserId])
}

model Conversation {
  id           Int                        @id @default(autoincrement())
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             Int           @id @default(autoincrement())
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  postId         Int?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String        @db.Text
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@index([postId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model Report {
  id             Int            @id @default(autoincrement())
  reporterId     Int
  reporter       User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId Int?
  reportedUser   User?          @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedPostId Int?
  reportedPost   Post?          @relation(fields: [reportedPostId], references: [id], onDelete: Cascade)
  severity       ReportSeverity @default(MEDIUM)
  context        String?
  reason         String         @db.Text
  status         ReportStatus   @default(PENDING)
  action         ReportAction   @default(NONE)
  resolvedById   Int?
  resolvedBy     User?          @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([status])
  @@index([reportedPostId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// --- Admin panel: RBAC, moderation, content, and support ---------------

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?          @db.Text
  editable    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id       Int             @id @default(autoincrement())
  roleId   Int
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource AdminResource
  level    PermissionLevel @default(NONE)

  @@unique([roleId, resource])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int
  actor      User        @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     AuditAction
  targetType String?
  targetId   Int?
  detail     String?     @db.Text
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model PlatformSetting {
  id                        Int      @id @default(1)
  bannerText                String?  @db.Text
  bannerActive              Boolean  @default(false)
  maintenanceMode           Boolean  @default(false)
  maintenanceMessage        String?  @db.Text
  signupsEnabled            Boolean  @default(true)
  lobbyChatEnabled          Boolean  @default(true)
  scheduledSessionsEnabled  Boolean  @default(true)
  steamAutoSyncEnabled      Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @db.Text
  active    Boolean  @default(true)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([active])
}

model BlogPost {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  category    String
  excerpt     String?    @db.Text
  body        String     @db.Text
  coverSeed   String?
  status      BlogStatus @default(DRAFT)
  authorId    Int
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

model Ticket {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  TicketCategory  @default(GENERAL)
  priority  TicketPriority  @default(MEDIUM)
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  TicketMessage[]

  @@index([status])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  isStaff   Boolean  @default(false)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model DotaMatchStats {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wins         Int       @default(0)
  losses       Int       @default(0)
  rankTierHint Int?
  matches      Json
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

model ReferenceEntry {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(40)
  key       String   @db.VarChar(60)
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([category, key])
}
